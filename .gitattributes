# 统一换行符：文本文件在仓库与工作区都用 LF，避免 Windows/CI 之间来回转换
# （镜像页由 tools/sync-mirrors.mjs 生成，CI 会比对生成结果与仓库内容，必须保持一致）
* text=auto eol=lf

# 二进制资源不做文本处理
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary

# 生成物与文档
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.webmanifest text eol=lf
