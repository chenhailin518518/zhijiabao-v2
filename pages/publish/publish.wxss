.head {
  margin-bottom: 28rpx;
}

/* 估价带过来的建议卡片：用茶色描边和主色卡片区分开，避免被当成普通说明 */
.suggest {
  border-color: var(--tea-soft);
  background: linear-gradient(135deg, rgba(171, 132, 91, 0.1), rgba(171, 132, 91, 0.02));
}

.suggest-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-top: 8rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ============ 图片九宫格 ============ */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 4rpx;
}

.img-item {
  position: relative;
  width: 176rpx;
  height: 176rpx;
}

.img-thumb {
  width: 176rpx;
  height: 176rpx;
  border-radius: 16rpx;
  background: var(--moon-2);
}

.img-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--cinnabar);
  color: #fff;
  font-size: 22rpx;
}

.img-add {
  width: 176rpx;
  height: 176rpx;
  border-radius: 16rpx;
  border: 2rpx dashed var(--line);
  background: var(--moon);
  display: flex;
  align-items: center;
  justify-content: center;
}

.img-add-mark {
  font-size: 52rpx;
  color: var(--muted);
  line-height: 1;
}

/* ============ 提交 ============ */
.submit-btn {
  margin-top: 36rpx;
}

.foot-note {
  margin-top: 22rpx;
  text-align: center;
}
