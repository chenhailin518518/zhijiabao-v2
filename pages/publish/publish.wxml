<view class="page {{theme === 'dark' ? 'theme-dark' : ''}}">

  <view class="head">
    <text class="kicker">Publish</text>
    <text class="h1">发布闲置</text>
    <text class="lead">商品经发布校验与平台审核后才会出现在集市。名称与描述将进行敏感词过滤。</text>
  </view>

  <view class="card suggest" wx:if="{{suggested}}">
    <text class="muted small">来自 AI 估价的建议</text>
    <view class="between">
      <text class="suggest-name">{{suggested.name}}</text>
      <text class="price">{{suggested.priceText}}</text>
    </view>
    <text class="hint">已自动填入期望价与描述，可依据实际品相调整</text>
  </view>

  <!-- 图片 -->
  <view class="card">
    <text class="label">商品实拍图（必填，最多 {{maxImages}} 张）</text>
    <view class="img-grid">
      <view class="img-item" wx:for="{{images}}" wx:key="*this">
        <image class="img-thumb" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
        <text class="img-del" data-index="{{index}}" bindtap="removeImage">✕</text>
      </view>
      <view class="img-add" wx:if="{{images.length < maxImages}}" bindtap="addImages">
        <text class="img-add-mark">＋</text>
      </view>
    </view>
    <text class="hint">{{uploadHint}}</text>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <view class="form-row">
      <text class="label">商品名称</text>
      <input class="field" maxlength="40" value="{{form.name}}" data-key="name" bindinput="onInput" placeholder="2-40 个字符，例如：故宫云纹折扇" />
    </view>

    <view class="form-row">
      <text class="label">景区来源</text>
      <picker mode="selector" range="{{scenicRange}}" value="{{scenicIndex}}" bindchange="onScenicChange">
        <view class="picker-field">
          <text>{{scenicRange[scenicIndex]}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <view class="form-row">
      <text class="label">商品品类</text>
      <picker mode="selector" range="{{categoryRange}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-field">
          <text>{{categoryRange[categoryIndex]}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <view class="form-row">
      <text class="label">品相等级</text>
      <picker mode="selector" range="{{conditionRange}}" value="{{conditionIndex}}" bindchange="onConditionChange">
        <view class="picker-field">
          <text>{{conditionRange[conditionIndex]}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <view class="form-row">
      <text class="label">商品标签</text>
      <picker mode="selector" range="{{tagRange}}" value="{{tagIndex}}" bindchange="onTagChange">
        <view class="picker-field">
          <text>{{tagRange[tagIndex]}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 价格 -->
  <view class="card">
    <view class="form-row">
      <text class="label">期望售价（元）</text>
      <input class="field" type="digit" maxlength="6" value="{{form.price}}" data-key="price" bindinput="onInput" placeholder="1-100000" />
      <text class="hint">不得高于原价的 120%，超出将被校验拦截</text>
    </view>
    <view class="form-row">
      <text class="label">购买原价（元）</text>
      <input class="field" type="digit" maxlength="6" value="{{form.original}}" data-key="original" bindinput="onInput" placeholder="1-200000" />
    </view>
    <view class="form-row">
      <text class="label">运费（元）</text>
      <input class="field" type="digit" maxlength="3" value="{{form.freight}}" data-key="freight" bindinput="onInput" placeholder="0 表示包邮，上限 200" />
    </view>
  </view>

  <!-- 描述 -->
  <view class="card">
    <text class="label">品相说明</text>
    <textarea class="field-area" maxlength="300" value="{{form.description}}" data-key="description" bindinput="onInput" placeholder="请说明使用痕迹、配件是否齐全及有无瑕疵，描述越具体越便于成交" />
    <text class="hint">最长 300 字</text>
  </view>

  <button class="btn btn-block submit-btn" bindtap="submit" disabled="{{submitting}}">
    {{submitting ? '提交中…' : '提交发布'}}
  </button>

  <view class="foot-note">
    <text class="muted tiny">
      {{mode === 'online' ? '提交后进入平台审核队列。' : '本地演示模式下，普通账号发布的商品会先进「待审核」，用运营账号登录可在集市里看到它。'}}
    </text>
  </view>
</view>
