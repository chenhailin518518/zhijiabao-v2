.login-card {
  margin-top: 40rpx;
}

.login-desc {
  display: block;
  margin-top: 14rpx;
  line-height: 1.7;
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #244853, #7a5f3c);
  color: #f7f4ec;
  font-size: 48rpx;
  font-weight: 700;
}

.mine-tags {
  margin-top: 12rpx;
}

.credit-bar {
  margin-bottom: 24rpx;
}

.credit-bar .progress-track {
  margin-bottom: 10rpx;
}

.balance {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--cinnabar);
  margin-top: 6rpx;
}

.edit-row {
  margin-top: 24rpx;
}

.danger-text {
  color: var(--cinnabar);
}

.foot-note {
  margin-top: 40rpx;
  text-align: center;
  padding: 0 40rpx;
}
