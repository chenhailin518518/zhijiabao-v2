# =========================================================
# 智价宝 · 环境配置示例
# 使用方式：复制为 .env 后按本机情况修改（.env 已被 .gitignore 忽略，不会提交）
#   copy .env.example .env      （Windows PowerShell）
#   cp .env.example .env        （macOS / Linux）
# =========================================================

# ---------- MySQL 8 连接（二选一）----------
# 方式一：逐项配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=zhijiabao
MYSQL_PASSWORD=请改成你的密码
MYSQL_DATABASE=zhijiabao

# 方式二：用一条连接串覆盖上面的配置（优先级更高）
# MYSQL_URL=mysql://zhijiabao:密码@127.0.0.1:3306/zhijiabao

# 连接池大小
MYSQL_POOL_SIZE=10

# ---------- 服务端口 ----------
PORT=8080

# ---------- 上传目录（默认 server/uploads）----------
# UPLOAD_DIR=D:/zhijiabao-uploads

# ---------- 自动化测试使用独立库，避免污染演示数据 ----------
# 运行 npm test 时会自动使用 zhijiabao_test（见 tests/api.mjs）
